# FinWatch Zambia - Backend Environment Variables Example

# --- Security ---
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=finwatch-zambia-super-secret-key-change-this-in-production-2026
REGULATOR_INVITATION_CODE=SECRET_INVITATION_CODE

# --- Database ---
# Local SQLite
DATABASE_URL=sqlite:///./finwatch.db
# Production PostgreSQL (Supabase/Render)
SUPABASE_DB_URL=postgresql+psycopg2://user:password@host:port/dbname

# --- App Settings ---
DEBUG=True
ALLOWED_ORIGINS_RAW=http://localhost,https://localhost,capacitor://localhost,http://localhost:3000,http://localhost:8000,https://finwatch-backend.onrender.com,https://finwatch-zambia.vercel.app,https://finwatch-zambia-frontend.vercel.app

# --- Groq API (NLP & Chat) ---
# This key is dedicated exclusively to NLP processing (Narratives, Chat).
GROQ_API_KEY=your_nlp_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Groq API (Data Extraction) ---
# This key is dedicated to document parsing (PDF, CSV, XLSX).
EXTRACTION_GROQ_API_KEY=your_extraction_groq_api_key_here
EXTRACTION_GROQ_MODEL=openai/gpt-oss-20b

# --- Groq API (Documentation Assistant) ---
# This key is dedicated exclusively to the Documentation Assistant.
DOCS_GROQ_API_KEY=your_docs_groq_api_key_here

# --- OpenRouter API (Cloud Fallback) ---
# Fallback when Groq is IP-blocked on cloud providers like Render.
# Free tier: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# --- NLP Service Configuration ---
NLP_PRIMARY=groq
NLP_TEMPERATURE=0.2
NLP_MAX_TOKENS=1500

# --- Environment Detection ---
# Set to True when deploying to Render
RENDER=False
